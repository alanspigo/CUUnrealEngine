# =========================
# Unreal Engine .gitignore
# =========================

# Build results
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# VS / Rider / IDE
.vs/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Compiled source files
*.dll
*.exe
*.app
*.dylib
*.lib
*.so
*.o
*.obj

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Auto-generated project files
*.xcodeproj
*.xcworkspace

# Unreal Engine specific
*.uprojectdirs

# Backup files
*.bak
*.tmp
*.old

# Crash reports
Saved/Crashes/

# Shader cache
DerivedDataCache/

# Localization
Content/Localization/*

# Ignore pak files (optional, depends on workflow)
*.pak

# Ignore debug files
*.pdb

# Rider
.idea/

# Visual Studio Code
.vscode/

# Mac
*.dSYM

# Ignore autosaves
Saved/Autosaves/

# Ignore cooked content
Saved/Cooked/

# Ignore staging
Saved/StagedBuilds/

# Ignore logs
Saved/Logs/

# Ignore temp files
Saved/Temp/

# Ignore config backup files
Config/DefaultEditorPerProjectUserSettings.ini

# Keep important directories (force include)
!Binaries/
!Build/
!Config/
!Content/
!Plugins/
!Source/

# Keep .uproject file
!*.uproject